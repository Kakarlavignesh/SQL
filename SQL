CREATE DATABASE restaurant_management;

SHOW DATABASES;

USE restaurant_management;

SHOW TABLES;
CREATE TABLE restaurants(
    restaurant_id INT PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    price INT,
    rating INT
);

DESC restaurants;
INSERT INTO restaurants
VALUES
(1,'Paradise',500,5),
(2,'Mehfil',350,4),
(3,'Dominos',600,4),
(4,'Pizza Hut',700,5);

SELECT * FROM restaurants;
-- CREATE
INSERT INTO restaurants
VALUES(5,'KFC',450,4);

-- READ
SELECT * FROM restaurants;

-- UPDATE
UPDATE restaurants
SET price=550
WHERE restaurant_id=5;

-- DELETE
DELETE FROM restaurants
WHERE restaurant_id=5;

CREATE TABLE customers(
    customer_id INT PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    phone VARCHAR(15) UNIQUE,
    restaurant_id INT,
    FOREIGN KEY(restaurant_id)
    REFERENCES restaurants(restaurant_id)
);
SELECT *
FROM restaurants
WHERE price>400;

SELECT *
FROM restaurants
WHERE rating>=4;

SELECT *
FROM restaurants
WHERE price<600 AND rating=5;
SELECT *
FROM restaurants
WHERE name LIKE 'P%';

SELECT *
FROM restaurants
WHERE price BETWEEN 300 AND 600;

SELECT *
FROM restaurants
ORDER BY price DESC;

SELECT *
FROM restaurants
LIMIT 3;

SELECT *
FROM restaurants
LIMIT 2 OFFSET 1;

SELECT COUNT(*) FROM restaurants;

SELECT MAX(price) FROM restaurants;

SELECT MIN(price) FROM restaurants;

SELECT AVG(price) FROM restaurants;

SELECT SUM(price) FROM restaurants;

SELECT rating,COUNT(*)
FROM restaurants
GROUP BY rating;

SELECT rating,COUNT(*)
FROM restaurants
GROUP BY rating
HAVING COUNT(*)>=2;

SELECT
c.name,
r.name
FROM customers c
INNER JOIN restaurants r
ON c.restaurant_id=r.restaurant_id;

